#!/usr/bin/env bash
# Return to the programmable display stack after the patched firmware driver
# has resumed and relit the OLED.  Serialize overlapping systemd-resume and
# physical-lid notifications without bouncing an already-running bar.
set -euo pipefail

delay=${1:-3}
exec 9>/run/lock/t1-custom-bar-recover.lock
flock -n 9 || exit 0

sleep "$delay"
marker=/run/t1-custom-bar-sleep-stopped
[[ -e $marker ]] || exit 0
rm -f -- "$marker"
if ! systemctl start t1-custom-bar-live.service; then
  touch "$marker"
  exit 1
fi

custom_config_ready() {
  local path
  for path in /sys/bus/usb/devices/*; do
    [[ -r $path/idVendor && -r $path/idProduct && -r $path/bConfigurationValue ]] || continue
    [[ $(<"$path/idVendor") == 05ac && $(<"$path/idProduct") == 8600 ]] || continue
    [[ $(<"$path/bConfigurationValue") == 2 ]]
    return
  done
  return 1
}

for _ in {1..40}; do
  if systemctl is-active --quiet t1-custom-bar-live.service && custom_config_ready; then
    exit 0
  fi
  sleep 0.25
done

touch "$marker"
exit 1
