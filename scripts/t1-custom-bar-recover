#!/usr/bin/env bash
# Return to the programmable display stack after the patched firmware driver
# has resumed and relit the OLED.  Serialize overlapping systemd-resume and
# physical-lid notifications without bouncing an already-running bar.
set -euo pipefail

delay=${1:-3}
exec 9>/run/lock/t1-custom-bar-recover.lock
flock -n 9 || exit 0

sleep "$delay"
marker=/run/t1-custom-bar-sleep-stopped
[[ -e $marker ]] || exit 0
rm -f -- "$marker"
started_at=$(date --iso-8601=seconds)
if ! systemctl start t1-custom-bar-live.service; then
  touch "$marker"
  exit 1
fi

custom_config_ready() {
  local path
  for path in /sys/bus/usb/devices/*; do
    [[ -r $path/idVendor && -r $path/idProduct && -r $path/bConfigurationValue ]] || continue
    [[ $(<"$path/idVendor") == 05ac && $(<"$path/idProduct") == 8600 ]] || continue
    [[ $(<"$path/bConfigurationValue") == 2 ]]
    return
  done
  return 1
}

process_is() {
  local pid=$1 expected=$2 actual=''
  [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  actual=$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)
  [[ $actual == "$expected" ]]
}

for _ in {1..40}; do
  context_pid=''
  [[ -r /run/t1-custom-bar/contextd.pid ]] &&
    read -r context_pid < /run/t1-custom-bar/contextd.pid
  dfrd_line=$(journalctl -u t1-custom-bar-live.service --since "$started_at" \
    --no-pager -o cat | sed -n '/dfrd: up\./p' | tail -n1)
  render_pid=$(sed -n 's/.*render=\([0-9][0-9]*\).*/\1/p' <<<"$dfrd_line")
  touch_pid=$(sed -n 's/.*touchd=\([0-9][0-9]*\).*/\1/p' <<<"$dfrd_line")
  fnd_pid=$(sed -n 's/.*fnd=\([0-9][0-9]*\).*/\1/p' <<<"$dfrd_line")
  if systemctl is-active --quiet t1-custom-bar-live.service &&
     custom_config_ready &&
     [[ -s /run/t1-custom-bar/layout.committed ]] &&
     [[ ! -e /run/t1-custom-bar/layout.pending ]] &&
     process_is "$context_pid" /run/t1-custom-bar/dfr-contextd &&
     process_is "$render_pid" /run/t1-custom-bar/dfr-render &&
     process_is "$touch_pid" /run/t1-custom-bar/dfr-touchd &&
     process_is "$fnd_pid" /run/t1-custom-bar/dfr-fnd; then
    exit 0
  fi
  sleep 0.25
done

systemctl stop t1-custom-bar-live.service >/dev/null 2>&1 || true
touch "$marker"
exit 1
