# MacBookPro13,2: T1 remote wake causes immediate s2idle wake via ACPI GPE 6D.
# Keep lid/keyboard wake and the T1's normal operation; disable only USB wake.
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8600", ATTR{power/wakeup}="disabled"
