#!/usr/bin/env bash
# Park the programmable strip in firmware mode as soon as the lid closes, then
# restore it after reopen.  This is also a safety net for stay-awake sessions,
# where no systemd suspend/resume target is reached.
set -euo pipefail

lid_state=/proc/acpi/button/lid/LID0/state

[[ -r $lid_state ]] || {
  printf 'T1 lid watcher: %s is unavailable\n' "$lid_state" >&2
  exit 78
}

read_lid() {
  awk '{ print $2 }' "$lid_state"
}

previous=$(read_lid)
printf 'T1 lid watcher: initial state=%s\n' "$previous"

while sleep 0.25; do
  current=$(read_lid)
  if [[ $previous == open && $current == closed ]]; then
    printf 'T1 lid watcher: closed; parking in firmware mode\n'
    if systemctl is-active --quiet t1-custom-bar-live.service; then
      if systemctl stop t1-custom-bar-live.service; then
        touch /run/t1-custom-bar-sleep-stopped
      else
        printf 'T1 lid watcher: failed to park programmable bar\n' >&2
      fi
    fi
  elif [[ $previous == closed && $current == open ]]; then
    printf 'T1 lid watcher: reopened; scheduling custom mode\n'
    # The normal post-suspend unit may win this race.  If no sleep transaction
    # happened, this path restores the bar after the panel has settled.
    /usr/local/lib/omarchy-t1-touchbar/t1-custom-bar-recover 3 &
  fi
  previous=$current
done
