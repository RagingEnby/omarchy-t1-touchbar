diff --git a/src/conf.c b/src/conf.c
index 609d246..d5450ae 100644
--- a/src/conf.c
+++ b/src/conf.c
@@ -254,7 +254,7 @@ static int internal_set_value(const char *config_file, const char *key, plist_t
 		usbmuxd_log(LL_DEBUG, "Setting key %s in config file %s", key, config_file);
 	}
 
-	int res = plist_write_to_filename(config, config_file, PLIST_FORMAT_XML);
+	int res = plist_write_to_filename(config, config_file, USBMUXD_PLIST_FORMAT_XML);
 
 	plist_free(config);
 
@@ -428,7 +428,7 @@ int config_set_device_record(const char *udid, char* record_data, uint64_t recor
 	remove(device_record_file);
 
 	/* store file */
-	if (!plist_write_to_filename(plist, device_record_file, PLIST_FORMAT_XML)) {
+	if (!plist_write_to_filename(plist, device_record_file, USBMUXD_PLIST_FORMAT_XML)) {
 		usbmuxd_log(LL_DEBUG, "Could not open '%s' for writing: %s", device_record_file, strerror(errno));
 		res = -ENOENT;
 	}
diff --git a/src/usb.c b/src/usb.c
index 39917ef..8ca2ded 100644
--- a/src/usb.c
+++ b/src/usb.c
@@ -817,9 +817,13 @@ int usb_init(void)
 #ifdef HAVE_LIBUSB_HOTPLUG_API
 	if (libusb_has_capability(LIBUSB_CAP_HAS_HOTPLUG)) {
 		usbmuxd_log(LL_INFO, "Registering for libusb hotplug events");
-		res = libusb_hotplug_register_callback(NULL, LIBUSB_HOTPLUG_EVENT_DEVICE_ARRIVED | LIBUSB_HOTPLUG_EVENT_DEVICE_LEFT, LIBUSB_HOTPLUG_ENUMERATE, VID_APPLE, LIBUSB_HOTPLUG_MATCH_ANY, 0, usb_hotplug_cb, NULL, &usb_hotplug_cb_handle);
+		/* T1 restored exposes a device-class value that is not zero. Matching
+		 * class 0 silently misses the interface and prevents the FDR session. */
+		res = libusb_hotplug_register_callback(NULL, LIBUSB_HOTPLUG_EVENT_DEVICE_ARRIVED | LIBUSB_HOTPLUG_EVENT_DEVICE_LEFT, LIBUSB_HOTPLUG_ENUMERATE, VID_APPLE, LIBUSB_HOTPLUG_MATCH_ANY, LIBUSB_HOTPLUG_MATCH_ANY, usb_hotplug_cb, NULL, &usb_hotplug_cb_handle);
 		if (res == LIBUSB_SUCCESS) {
-			device_polling = 0;
+			/* Scan immediately when the internal iBridge was already present
+			 * before this private usbmuxd started. */
+			device_polling = 1;
 		} else {
 			usbmuxd_log(LL_ERROR, "ERROR: Could not register for libusb hotplug events. %s", libusb_error_name(res));
 		}
diff --git a/src/utils.c b/src/utils.c
index 206c684..ff6cf95 100644
--- a/src/utils.c
+++ b/src/utils.c
@@ -310,9 +310,9 @@ int plist_write_to_filename(plist_t plist, const char *filename, enum plist_form
 	if (!plist || !filename)
 		return 0;
 
-	if (format == PLIST_FORMAT_XML)
+	if (format == USBMUXD_PLIST_FORMAT_XML)
 		plist_to_xml(plist, &buffer, &length);
-	else if (format == PLIST_FORMAT_BINARY)
+	else if (format == USBMUXD_PLIST_FORMAT_BINARY)
 		plist_to_bin(plist, &buffer, &length);
 	else
 		return 0;
