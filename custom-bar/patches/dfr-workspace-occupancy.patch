+static int is_number(const char *s)
+{
+	if (!s || !*s)
+		return 0;
+	for (; *s; s++)
+		if (*s < '0' || *s > '9')
+			return 0;
+	return 1;
+}
+
+/* Find the newest Hyprland command socket across logged-in desktop users. */
+static int find_hypr_socket(char *out, size_t n)
+{
+	DIR *users = opendir("/run/user");
+	if (!users)
+		return -1;
+	struct timespec newest = { 0, 0 };
+	struct dirent *user;
+	out[0] = 0;
+	while ((user = readdir(users))) {
+		if (!is_number(user->d_name) || strtol(user->d_name, NULL, 10) < 1000)
+			continue;
+		char hypr[PATH_MAX];
+		if (snprintf(hypr, sizeof hypr, "/run/user/%s/hypr", user->d_name) >=
+		    (int)sizeof hypr)
+			continue;
+		DIR *instances = opendir(hypr);
+		if (!instances)
+			continue;
+		struct dirent *instance;
+		while ((instance = readdir(instances))) {
+			if (instance->d_name[0] == '.')
+				continue;
+			char path[PATH_MAX];
+			if (snprintf(path, sizeof path, "%s/%s/.socket.sock",
+				     hypr, instance->d_name) >= (int)sizeof path)
+				continue;
+			struct stat st;
+			if (stat(path, &st) < 0 || !S_ISSOCK(st.st_mode))
+				continue;
+			if (!out[0] || st.st_mtim.tv_sec > newest.tv_sec ||
+			    (st.st_mtim.tv_sec == newest.tv_sec &&
+			     st.st_mtim.tv_nsec > newest.tv_nsec)) {
+				if (strlen(path) >= n)
+					continue;
+				snprintf(out, n, "%s", path);
+				newest = st.st_mtim;
+			}
+		}
+		closedir(instances);
+	}
+	closedir(users);
+	return out[0] ? 0 : -1;
+}
+
+static int hypr_request(const char *request, char *response, size_t n)
+{
+	char path[PATH_MAX];
+	if (find_hypr_socket(path, sizeof path) < 0)
+		return -1;
+	if (strlen(path) >= sizeof(((struct sockaddr_un *)0)->sun_path))
+		return -1;
+
+	int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+	if (fd < 0)
+		return -1;
+	struct timeval timeout = { .tv_sec = 0, .tv_usec = 150000 };
+	setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof timeout);
+	setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof timeout);
+	struct sockaddr_un addr;
+	memset(&addr, 0, sizeof addr);
+	addr.sun_family = AF_UNIX;
+	snprintf(addr.sun_path, sizeof addr.sun_path, "%s", path);
+	if (connect(fd, (struct sockaddr *)&addr, sizeof addr) < 0) {
+		close(fd);
+		return -1;
+	}
+
+	size_t left = strlen(request);
+	const char *p = request;
+	while (left) {
+		ssize_t wrote = write(fd, p, left);
+		if (wrote <= 0) {
+			close(fd);
+			return -1;
+		}
+		p += wrote;
+		left -= (size_t)wrote;
+	}
+	shutdown(fd, SHUT_WR);
+
+	size_t used = 0;
+	while (used + 1 < n) {
+		ssize_t got = read(fd, response + used, n - used - 1);
+		if (got == 0)
+			break;
+		if (got < 0) {
+			if (errno == EINTR)
+				continue;
+			close(fd);
+			return -1;
+		}
+		used += (size_t)got;
+	}
+	close(fd);
+	response[used] = 0;
+	return used ? 0 : -1;
+}
+
+static int workspace_refresh(void)
+{
+	char response[65536];
+	if (hypr_request("j/workspaces", response, sizeof response) < 0)
+		return 0;
+
+	unsigned next = 0;
+	const char *p = response;
+	while ((p = strstr(p, "\"id\""))) {
+		const char *id_colon = strchr(p, ':');
+		if (!id_colon)
+			break;
+		char *id_end;
+		long id = strtol(id_colon + 1, &id_end, 10);
+		const char *next_id = strstr(id_end, "\"id\"");
+		const char *windows = strstr(id_end, "\"windows\"");
+		if (windows && (!next_id || windows < next_id)) {
+			const char *win_colon = strchr(windows, ':');
+			long count = win_colon ? strtol(win_colon + 1, NULL, 10) : 0;
+			if (id >= 1 && id <= 10 && count > 0)
+				next |= 1u << (id - 1);
+		}
+		p = next_id ? next_id : id_end;
+		if (!next_id)
+			break;
+	}
+	int changed = next != g_workspace_mask;
+	g_workspace_mask = next;
+	return changed;
+}
 
