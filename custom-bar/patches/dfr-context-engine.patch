+/* Atomically publish one layout index. The pending file is a fail-closed fence;
+ * the committed file is the hit map touchd may adopt. */
+static int publish_layout_file(const char *path, int layout_idx)
+{
+	char tmp[PATH_MAX], payload[32];
+	if (snprintf(tmp, sizeof tmp, "%s.tmp.%ld", path,
+		     (long)getpid()) >= (int)sizeof tmp)
+		return -1;
+	int len = snprintf(payload, sizeof payload, "%d\n", layout_idx);
+	if (len <= 0 || len >= (int)sizeof payload)
+		return -1;
+
+	int out = open(tmp, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+	if (out < 0)
+		return -1;
+	int used = 0;
+	while (used < len) {
+		ssize_t n = write(out, payload + used, (size_t)(len - used));
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n <= 0) {
+			close(out);
+			unlink(tmp);
+			return -1;
+		}
+		used += (int)n;
+	}
+	int failed = fsync(out) < 0;
+	int saved = failed ? errno : 0;
+	if (close(out) < 0 && !failed) {
+		failed = 1;
+		saved = errno;
+	}
+	if (!failed && rename(tmp, path) < 0) {
+		failed = 1;
+		saved = errno;
+	}
+	if (failed) {
+		unlink(tmp);
+		errno = saved;
+		return -1;
+	}
+	return 0;
+}
