+static int frame_sequence_path(int drm_fd, char *out, size_t n)
+{
+	struct stat st;
+	if (fstat(drm_fd, &st) < 0)
+		return -1;
+	int len = snprintf(out, n, "/sys/dev/char/%u:%u/device/%s",
+			   major(st.st_rdev), minor(st.st_rdev),
+			   DFR_FRAME_SEQUENCE_ATTR);
+	if (len < 0 || (size_t)len >= n) {
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+	return access(out, R_OK);
+}
+
+static int read_frame_sequence(const char *path, uint64_t *sequence)
+{
+	FILE *f = fopen(path, "r");
+	if (!f)
+		return -1;
+	unsigned long long value;
+	errno = 0;
+	int ok = fscanf(f, "%llu", &value) == 1;
+	int saved = errno;
+	if (fclose(f) < 0 && ok) {
+		ok = 0;
+		saved = errno;
+	}
+	if (!ok) {
+		errno = saved ? saved : EIO;
+		return -1;
+	}
+	*sequence = (uint64_t)value;
+	return 0;
+}
