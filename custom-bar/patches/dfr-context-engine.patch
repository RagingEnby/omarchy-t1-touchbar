+/* The DRM atomic callback cannot return a late USB failure to modeset callers.
+ * Wait for the driver's read-only counter, which advances only after a complete
+ * bulk OUT, at least one device response, and a bounded response-queue drain.
+ * This confirms transport completion, not panel pixel readback. */
+static int wait_frame_advance(const char *path, uint64_t before)
+{
+	int64_t deadline = now_ms() + FRAME_RESPONSE_WAIT_MS;
+	do {
+		uint64_t after;
+		if (read_frame_sequence(path, &after) < 0)
+			return -1;
+		if (after > before)
+			return 0;
+		usleep(5000);
+	} while (now_ms() < deadline);
+	errno = ETIMEDOUT;
+	return -1;
+}
