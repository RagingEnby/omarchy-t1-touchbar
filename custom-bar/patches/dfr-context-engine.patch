+static int take_layout_request(const sigset_t *layout_signals,
+			       int current_layout, int *requested_layout)
+{
+	sigset_t previous;
+	if (sigprocmask(SIG_BLOCK, layout_signals, &previous) < 0)
+		return -1;
+	sig_atomic_t cycle = g_cycle;
+	sig_atomic_t requested = g_setlayout;
+	g_cycle = 0;
+	g_setlayout = -1;
+	if (sigprocmask(SIG_SETMASK, &previous, NULL) < 0)
+		return -1;
+	*requested_layout = cycle ? (current_layout + 1) % DFR_NLAYOUTS :
+		(int)requested;
+	return 0;
