+static int workspace_number(const struct dfr_key *k)
+{
+	if (k->indicator < DFR_IND_WORKSPACE_1 ||
+	    k->indicator > DFR_IND_WORKSPACE_10)
+		return 0;
+	return k->indicator - DFR_IND_WORKSPACE_1 + 1;
+}
+
+/* Workspace actions wait for finger-up so a tap and a horizontal drag can
+ * share the same zones. A drag from one numbered zone to another merges all
+ * source-workspace windows into the target; releasing anywhere else is the
+ * ordinary source-workspace tap. */
+static void end_contact(int *down, int *down_key, int *drag_source,
+			int *drag_target, const char **down_cmd, int dry_run,
+			int verbose, int64_t *last_launch)
+{
+	if (!*down)
+		return;
+
+	if (*drag_source) {
+		char merge_cmd[128];
+		const char *cmd = *down_cmd;
+		int target = *drag_target;
+		if (target && target != *drag_source) {
+			snprintf(merge_cmd, sizeof merge_cmd,
+				 "/run/t1-custom-bar/touchbar-action workspace-merge %d %d",
+				 *drag_source, target);
+			cmd = merge_cmd;
+			printf("UP workspace drag %d -> %d: %s%s\n",
+			       *drag_source, target, cmd, dry_run ? " (dry)" : "");
+		} else {
+			printf("UP workspace tap %d: %s%s\n", *drag_source, cmd,
+			       dry_run ? " (dry)" : "");
+		}
+
+		int64_t t = now_ms();
+		if (cmd && t - *last_launch >= LAUNCH_DEBOUNCE_MS) {
+			*last_launch = t;
+			if (!dry_run)
+				launch_cmd(cmd);
+		} else if (cmd) {
+			printf("UP workspace action debounced\n");
+		}
+	} else if (!dry_run && *down_key) {
+		key_up(*down_key);
+	}
+
+	if (verbose && !*drag_source) {
+		printf("UP\n");
+		fflush(stdout);
+	}
+	*down = 0;
+	*down_key = 0;
+	*drag_source = 0;
+	*drag_target = 0;
+	*down_cmd = NULL;
+}
